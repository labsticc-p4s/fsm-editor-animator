use org.openflexo.technologyadapter.diagram.TypedDiagramModelSlot as DIAGRAM;
use org.openflexo.technologyadapter.emf.EMFModelSlot as EMF;

import org.openflexo.technologyadapter.diagram.model.Diagram;
import org.openflexo.technologyadapter.diagram.metamodel.DiagramSpecification;
import org.openflexo.technologyadapter.emf.model.EMFModel;
import org.openflexo.technologyadapter.diagram.model.DiagramShape;
import org.openflexo.technologyadapter.emf.model.EMFObjectIndividual;
import org.openflexo.technologyadapter.emf.metamodel.EMFMetaModel;
import org.openflexo.technologyadapter.emf.metamodel.EMFClassClass;
import org.openflexo.technologyadapter.diagram.model.DiagramShapeImpl_$$_jvstd51_87;

import EMFMetaModel FSM_V1 from ["http://examples.openflexo.org/fsmV1"];
import EMFClassClass STATE from [FSM_V1:"State"];

import DiagramSpecification FSM_V1EDITORSPEC from ["http://examples.openflexo.org/fsmV1-editor"];
import Diagram EXAMPLE_DIAGRAM from ["http://examples.openflexo.org/fsmV1-editor/ExampleDiagram.diagram"];
import DiagramShape REGULAR_STATE_SHAPE from [EXAMPLE_DIAGRAM:"SYL-2"];
import DiagramShape INITIAL_STATE_SHAPE_1 from [EXAMPLE_DIAGRAM:"SYL-3"];
import DiagramShape INITIAL_STATE_SHAPE_2 from [EXAMPLE_DIAGRAM:"SYL-4"];

typedef EMFObjectIndividualType(eClass=STATE) as State;

@URI("file:/Users/sylvainguerin/GIT-2.99/fsm-editor-animator//fsm-editor-animator/FML/FsmV1Editor.fml")
model FsmV1Editor {
	Diagram diagram with TypedDiagram(
      diagramSpecification=FSM_V1EDITORSPEC,
      paletteElementBindings={
         PaletteElementBinding:(
            call=new RegularStateGR::dropRegularStateGRAtTopLevel(), 
            paletteElementId="http://examples.openflexo.org/fsmV1-editor/Palette.palette#RegularStateGR"), 
         PaletteElementBinding:(
            call=new InitialStateGR::dropInitialStateGRAtTopLevel(), 
            paletteElementId="http://examples.openflexo.org/fsmV1-editor/Palette.palette#InitialStateGR")});
	EMFModel fsm with EMFModelSlot(metaModel=FSM_V1);

	create::createNewModel() {
		diagram = DIAGRAM::CreateDiagram(resourceName="diagram",resourceCenter=this.resourceCenter,relativePath="Diagrams");
	}

   create::editExistingModel(Resource<EMFModel> aModel) {
      connect fsm using parameters.aModel;
      diagram = DIAGRAM::CreateDiagram(resourceName="diagram",resourceCenter=this.resourceCenter,relativePath="Diagrams");
      this.synchronizeDiagramFromModel();
      /*for (State state : select State from fsm) {
         log "State: " + state;
         RegularStateGR newRegularStateGR = new RegularStateGR::drawRegularState(state); 
      }*/
   }

   public synchronizeDiagramFromModel() {
      MatchingSet<RegularStateGR> matchingSet = begin match RegularStateGR from this;
      for (State aState : select State from fsm) {
         match RegularStateGR in matchingSet from this where (state=aState) unmatched: new RegularStateGR::drawRegularState(aState);
      }
   }

   public debug() {
      for (State state : select State from fsm) {
         log "State: " + state;
      }
   }

	concept RegularStateGR {
		DiagramShape shape with ShapeRole(metamodelElement=REGULAR_STATE_SHAPE,label=state.name);
		State state with EMFObjectRole(type=STATE);

      RegularStateGR dropRegularStateGRAtTopLevel() with DropScheme(targetType=FsmV1Editor) {
			state = EMF::AddEMFObject(individualName="State",ontologyClass=STATE) in fsm;
			shape = DIAGRAM::AddShape(container=topLevel) in diagram;
		}

      create::drawRegularState(State aState) {
         log "Draw state " + parameters.aState;
         state = parameters.aState;
         shape = DIAGRAM::AddShape(container=diagram) in diagram;
     }

	delete() {
		delete shape;
		delete state;
	}

	}

	concept InitialStateGR {
		DiagramShape outline with ShapeRole(metamodelElement=INITIAL_STATE_SHAPE_1);
		DiagramShape center with ShapeRole(metamodelElement=INITIAL_STATE_SHAPE_2,containerElement=outline);
		State state with EMFObjectRole(type=STATE);

		InitialStateGR dropInitialStateGRAtTopLevel() with DropScheme(targetType=FsmV1Editor) {
			state = EMF::AddEMFObject(individualName=parameters.uri,ontologyClass=STATE) in fsm;
			outline = DIAGRAM::AddShape(container=topLevel) in diagram;
         center = DIAGRAM::AddShape() in diagram;
		}

	delete() {
		delete outline;
		delete center;
		delete state;
	}
	}
}
